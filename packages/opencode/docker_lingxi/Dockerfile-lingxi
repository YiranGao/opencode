FROM ubuntu:22.04

ARG BUN_RUNTIME_TRANSPILER_CACHE_PATH=0
ENV BUN_RUNTIME_TRANSPILER_CACHE_PATH=${BUN_RUNTIME_TRANSPILER_CACHE_PATH}

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libgcc-s1 \
        libstdc++6 \
        ripgrep && \
    rm -rf /var/lib/apt/lists/*

ARG LINGXICODE_RELEASE_DIR
COPY ${LINGXICODE_RELEASE_DIR} /lingxicode
RUN echo "${LINGXICODE_RELEASE_DIR}" > /lingxicode/version.txt

RUN chmod -R +x /lingxicode/

RUN /lingxicode/lingxicode.sh --version
ENTRYPOINT ["/lingxicode/lingxicode.sh"]